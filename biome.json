{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!design", "!**/*.md", "!src-tauri/gen", "!src-tauri/target"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "off",
      "correctness": { "useExhaustiveDependencies": "off" },
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "complexity": { "noImportantStyles": "off" },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noControlCharactersInRegex": "off",
        "noTemplateCurlyInString": "off",
        "noFocusedTests": "off",
        "noDuplicateTestHooks": "off",
        "noPrototypeBuiltins": "off"
      }
    }
  },
  "overrides": [
    { "includes": ["index.html"], "linter": { "rules": { "correctness": { "noInnerDeclarations": "off" } } } }
  ],
  "css": { "parser": { "cssModules": true }, "formatter": { "quoteStyle": "single" } }
}
