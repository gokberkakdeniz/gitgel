#!/bin/sh
# Conventional Commits: `type(scope)!: subject`. Skip with --no-verify.
subject=$(head -n 1 "$1")
case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac
if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*$'; then
  echo "commit-msg: not a Conventional Commit: \"$subject\"" >&2
  echo "  expected: type(scope): subject" >&2
  echo "  types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
