{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gitgel",
  "version": "../package.json",
  "identifier": "com.gitgel.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gitgel",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "trafficLightPosition": {
          "x": 16,
          "y": 28.5
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://raw.githubusercontent.com/gokberkakdeniz/homebrew-tap/master/gitgel/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwOTNFOTJDQjk4MjdEMUMKUldRY2ZZSzVMT21UVUtqRDY3RU16eWYvSVJpb2gyT3pkS3hJQ3BLdDZXWjJLSnplTjV4QmlVM1IK"
    }
  }
}
